# Campus Care — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_VERSION=1.0.0

# ── Supabase (Phase 2 Authentication & Database) ─────────────────────────────
# Create a project at https://supabase.com and copy credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ── Map Provider (Phase 2+) ──────────────────────────────────────────────────
# Supported: google | mapbox | leaflet
VITE_MAP_PROVIDER=google
VITE_MAP_API_KEY=
